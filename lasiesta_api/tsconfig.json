{
  "compilerOptions": {
    "target": "ES2020",
    // "module": "Node16",
    // "moduleResolution": "node16",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "ignoreDeprecations": "6.0",
    
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
