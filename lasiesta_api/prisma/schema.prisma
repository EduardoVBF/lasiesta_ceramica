

// Criar o cliente do Prisma com o provedor JavaScript
generator client {
  provider = "prisma-client-js"
}

// Configurar a fonte de dados para PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// MODELS PARA MIGRAÇÕES E INTERAÇÕES COM O BANCO DE DADOS
model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String   @unique
  passwordHash  String
  role          String   @default("admin")
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  imageUrl  String?
  isActive  Boolean  @default(true)

  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  price            Decimal
  shortDescription String?
  longDescription  String?
  material         String?
  dimensions       String?
  colors           Json?
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(true)
  orderIndex       Int      @default(0)

  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
